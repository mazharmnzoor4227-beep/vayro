# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
app/build/
.gradle/
.kotlin/

# Android Studio / IntelliJ IDEA / VS Code project files
.idea/
.vscode/
*.iml
*.iws
*.ipr

# Local configuration file (SDK location, local keys, etc.)
local.properties
test-secrets.properties

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Profiling tools
captures/

# Keystore files (signing keys)
*.jks
*.keystore

# External native build folder
.externalNativeBuild
.cxx/

# macOS system files
.DS_Store
.AppleDouble
.LSSharedFileList
._*



.gradle-home/

# Locally produced runtime bundles and their downloaded source archives.
# Publish release artifacts separately; keep the small manifest in Git.
dist/runtime-bundles/*.tar.zst
dist/runtime-bundles/*.invalid
dist/runtime-bundles/sources/

# Generated local in-app update test artifacts.
dist/update-test/

# Local attachments
attachments/

# Release distribution builds
release-dist/

# Runtime synchronized agent skills
.agents/

# Release notes markdown files (release notes are published to GitHub Releases directly)
release-notes*.md

# Source packages literally named "build" (app-factory code generators).
# The generic build/ pattern above would silently swallow NEW source files
# in these directories (the existing files are only safe because they were
# force-tracked once). Re-include the directories and everything inside them
# so sources here are never ignored; real Gradle output dirs stay ignored.
!app/src/main/java/com/vayro/app/factory/build/
!app/src/main/java/com/vayro/app/factory/build/**
!app/src/test/java/com/vayro/app/factory/build/
!app/src/test/java/com/vayro/app/factory/build/**
