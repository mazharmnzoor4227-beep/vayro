<?xml version="1.0" encoding="utf-8"?>
<!--
  v3.2.46 (audit H2): resource shrinking is enabled for release.
  default_web_client_id is generated by the google-services plugin and is
  looked up BY NAME at runtime (OnlineGoogleSignInHandler uses
  Resources.getIdentifier), so the shrinker cannot see the reference.
  Keep it or Google sign-in loses its OAuth client id.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/default_web_client_id" />
